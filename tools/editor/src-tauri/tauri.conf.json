{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squarefolk 数据工坊",
  "version": "0.1.0",
  "identifier": "app.squarefolk.editor",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Squarefolk 数据工坊",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
