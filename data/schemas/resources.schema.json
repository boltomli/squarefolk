{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "squarefolk/data/resources.schema.json",
  "title": "Squarefolk content layer: resources.json",
  "type": "object",
  "required": ["schemaVersion", "rulesVersion", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "rulesVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["effect", "amount"],
        "additionalProperties": false,
        "properties": {
          "effect": { "type": "string", "enum": ["pop", "stars"] },
          "amount": { "type": "integer", "minimum": 0 },
          "tech": { "type": "string", "pattern": "^\\w+\\.\\w+$" }
        }
      }
    }
  }
}
