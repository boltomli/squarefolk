            "properties": {
              "atk10": {
                "type": "integer",
                "minimum": 0
              },
              "def10": {
                "type": "integer",
                "minimum": 0
              },
              "defTotalCap": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "movement": {
      "type": "object",
      "required": [
        "halfPointsPerPoint",
        "cost2",
        "overshootAllowance2"
