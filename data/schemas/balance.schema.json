      "required": [
        "source",
        "minMapSize",
        "maxMapSize",
        "terrainWeights",
        "smoothRounds",
        "smoothPriority",
        "villageCount",
        "resourceCount",
        "resourcePlacement",
        "spawnTerrains",
        "minSpawnEdge",
        "minReach",
        "dMin",
        "epsilon",
        "retryCap",
        "spawnCount",
        "scoreRadius",
        "wNearVillage",
        "wResource",
        "wMobility",
        "wEdge",
        "wRuin",
        "resourceValue"
