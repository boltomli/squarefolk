            "road": {
              "type": "integer",
              "minimum": 0
            },
            "city": {
              "type": "integer",
              "minimum": 0
            },
            "swamp": {
              "type": "integer",
              "minimum": 0
            },
            "default": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "overshootAllowance2": {
          "type": "integer",
          "minimum": 0
        }
      }
