            "enabled",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "boni": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
