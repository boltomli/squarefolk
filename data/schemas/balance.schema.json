        "mReductionPercentPerPoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "def10PerPoint": {
          "type": "integer",
          "minimum": 0
        },
        "def10Cap": {
          "type": "integer",
          "minimum": 0
        },
        "damageDenominator": {
          "type": "integer",
          "minimum": 1
