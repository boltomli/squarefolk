    "vision": {
      "type": "object",
      "required": [
        "unitRadius",
        "mountainUnitRadius",
        "cityRadius"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "unitRadius": {
          "type": "integer",
          "minimum": 0
