        "wNearVillage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "wResource": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "wMobility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "wEdge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "wRuin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "resourceValue": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
