{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "squarefolk/data/balance.schema.json",
  "title": "Squarefolk rules layer: balance.json（结构校验：类型 / 必填 / 枚举 / 区间）",
  "type": "object",
  "required": [
    "schemaVersion",
    "combat",
    "movement",
    "vision",
    "territory",
    "economy",
    "elimination",
    "promotion",
    "world"
  ],
  "additionalProperties": false,
