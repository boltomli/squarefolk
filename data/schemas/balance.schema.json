            "forest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "mountain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "swamp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "water": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "smoothRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "smoothPriority": {
          "type": "array",
          "items": {
            "enum": [
              "plain",
              "forest",
              "mountain",
              "swamp",
              "water"
            ]
          }
        },
        "villageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "resourceCount": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        },
        "resourcePlacement": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "plain",
                "forest",
                "mountain",
                "swamp",
                "water"
              ]
            }
          }
        },
        "spawnTerrains": {
          "type": "array",
          "items": {
            "enum": [
              "plain",
              "forest",
              "mountain",
              "swamp",
              "water"
            ]
          }
        },
        "minSpawnEdge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "minReach": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
