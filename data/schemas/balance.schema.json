    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "combat": {
      "type": "object",
      "required": [
        "damageK",
        "mReductionPercentPerPoint",
        "def10PerPoint",
        "def10Cap",
        "damageDenominator",
        "dyingCounterDivisor",
        "contentSafetyCap",
        "boni"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "damageK": {
          "type": "integer",
          "minimum": 1
